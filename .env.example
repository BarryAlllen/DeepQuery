# 指定加载的环境配置：development | production | testing
DEEPQUERY_ENV=development

# 来自 https://token.cvte.com 的 API Key，供底层 CLI 工具使用
DEEPQUERY_API_KEY=
# 公司 Anthropic 兼容网关地址（如 https://token.cvte.com/...）；为空则走 claude 默认
DEEPQUERY_CLAUDE_BASE_URL=

# 默认的 CLI 适配器（claude_code | opencode | cursor）
DEEPQUERY_DEFAULT_ADAPTER=claude_code

# 服务监听
DEEPQUERY_HOST=0.0.0.0
DEEPQUERY_PORT=8000

# 单次 CLI 调用的硬超时（秒），0 表示不限制
DEEPQUERY_CLI_TIMEOUT_SECONDS=120

# 本地 Markdown 知识库根目录
DEEPQUERY_KNOWLEDGE_DIR=./knowledge_base

# MCP filesystem 接入开关
DEEPQUERY_MCP_ENABLED=true
# 容器/无人值守环境跳过 claude 工具权限确认；本地调试可设为 false
DEEPQUERY_MCP_SKIP_PERMISSIONS=true
