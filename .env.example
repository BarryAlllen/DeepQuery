# Which env file to load: dev | prod | test
DEEPQUERY_ENV=dev

# API key for CLI tools (from https://token.cvte.com)
DEEPQUERY_API_KEY=

# Default CLI adapter name (claude_code | opencode | cursor)
DEEPQUERY_DEFAULT_ADAPTER=claude_code

# Server
DEEPQUERY_HOST=0.0.0.0
DEEPQUERY_PORT=8000

# Knowledge base root (local markdown docs)
DEEPQUERY_KNOWLEDGE_DIR=./knowledge_base
