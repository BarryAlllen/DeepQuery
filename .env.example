# ===== 必填 =====
# 当前环境标识：development | production | testing
DEEPQUERY_ENV=development

# ===== 上游 LLM 接入（二选一）=====
# 方案 A：填入 Key 与公司网关地址，由 DeepQuery 透传给 CLI 子进程
#   - 公司用户：到 https://token.cvte.com 申请 Key 与对应 base_url
#   - 个人用户：可填 Anthropic 官方 sk-ant-...（base_url 留空走默认）
DEEPQUERY_API_KEY=
DEEPQUERY_API_BASE_URL=
# 方案 B：留空上面两项，使用 CLI 自身的本地凭据（如 `claude login`）

# ===== 服务参数 =====
DEEPQUERY_HOST=0.0.0.0
DEEPQUERY_PORT=8000
# 默认 CLI 适配器：claude_code | opencode | cursor
DEEPQUERY_DEFAULT_ADAPTER=claude_code
# 单次 CLI 调用硬超时（秒），0 表示不限制
DEEPQUERY_CLI_TIMEOUT_SECONDS=120

# ===== 知识库 + MCP =====
DEEPQUERY_KNOWLEDGE_DIR=./knowledge_base
# 不配 DEEPQUERY_KNOWLEDGE_REPOS 即使用默认（单仓 shared 子目录、纯本地无 git）。
# 接 git 时填 JSON 数组，例如：
# DEEPQUERY_KNOWLEDGE_REPOS=[{"name":"shared","url":"git@github.com:cvte/kb-shared.git","branch":"main","subdir":"shared","scope":"public"}]
# 自动 git pull 间隔（秒），<=0 关闭后台自动同步（仍可手动 /api/knowledge/sync）
DEEPQUERY_KNOWLEDGE_AUTO_PULL_SECONDS=0
# webhook 共享密钥；为空则 /api/knowledge/webhook 不校验（仅用于本地调试）
DEEPQUERY_KNOWLEDGE_WEBHOOK_SECRET=

DEEPQUERY_MCP_ENABLED=true
# 容器/无人值守环境跳过 claude 工具权限确认；本地交互调试可设为 false
DEEPQUERY_MCP_SKIP_PERMISSIONS=true

# ===== 适配器级定制 =====
# opencode 适配器必须指定 provider/model 格式的模型名，如果 opencode.json 里
# 已经配了 default model 本项可省略。格式：JSON，每个 key 是 adapter 名。
# DEEPQUERY_ADAPTER_OPTIONS={"opencode":{"model":"cchClaude/claude-opus-4-7"}}

# ===== 问答历史 =====
# SQLite 默认放项目目录；生产容器里镜像固定为 /data/deepquery.db。
# 升级 Postgres 只改这一行即可：postgresql+asyncpg://user:pw@host/db
DEEPQUERY_DATABASE_URL=sqlite+aiosqlite:///./deepquery.db

